package 'cmake'
package 'ccache'
package 'git'
package 'jq'
package 'ninja-build', bin: 'ninja'
package 'pkg-config'

# libcurl is a dependency of the plugin itself, not of the build tooling. Windows
# and macOS get it from the obs-deps bundle; on Linux the template expects system
# packages, and the runner has the runtime but not the headers.
package 'libcurl4-openssl-dev'
