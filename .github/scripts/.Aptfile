package 'cmake'
package 'ccache'
package 'git'
package 'jq'
package 'ninja-build', bin: 'ninja'
package 'pkg-config'

# Dependencies of the plugin itself, not of the build tooling. Windows and macOS
# take both from the obs-deps bundle; on Linux the template expects system
# packages, and the runner carries libcurl's runtime without its headers and no
# nlohmann/json at all.
package 'libcurl4-openssl-dev'
package 'nlohmann-json3-dev'
